---
import { getCollection } from "astro:content";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import Showcase from "../components/sections/Showcase.astro";
import { getPublishedPortfolio } from "../domain/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";

const portfolio = getPublishedPortfolio(await getCollection("portfolio"));
---

<BaseLayout
  title="Trix — Portfólio de sites e sistemas"
  description="Conheça modelos de sites e sistemas e encontre um ponto de partida para seu projeto."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Showcase entries={portfolio} />
    <Services />
    <About />
    <Contact models={portfolio.map((entry) => ({ id: entry.id, title: entry.data.title }))} />
  </main>
  <Footer />
</BaseLayout>
