---
import Tag from "../ui/Tag.astro";

const services = [
  {
    title: "Sites",
    description:
      "Portfólios, páginas de apresentação e sites para mostrar serviços e aproximar clientes.",
  },
  {
    title: "Sistemas",
    description:
      "Painéis, agendas e ferramentas para organizar informações e simplificar tarefas.",
  },
  {
    title: "Do seu jeito",
    description:
      "Os modelos são um começo. Conteúdo, identidade e recursos acompanham a necessidade do projeto.",
  },
];
---

<section class="services" id="servicos">
  <div class="container services__inner">
    <div>
      <Tag index="02" text="O que eu crio" />
      <h2>Uma presença online.<br />Uma ferramenta útil.</h2>
      <p>Do site que apresenta seu trabalho ao sistema que ajuda no dia a dia.</p>
    </div>
    <ol class="services__list">
      {
        services.map((service, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .services {
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .services__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-16);
    padding-block: var(--section-space);
  }

  h2 {
    margin-block: var(--space-4) var(--space-6);
    font-size: var(--text-2xl);
  }

  .services__inner > div > p {
    max-width: 24rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .services__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-line);
  }

  li:first-child {
    padding-top: 0;
  }

  li > span {
    padding-top: var(--space-1);
    color: var(--color-brand);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  li p {
    max-width: 32rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (max-width: 48rem) {
    .services__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
