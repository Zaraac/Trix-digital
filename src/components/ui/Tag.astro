---
interface Props {
  text: string;
  index?: string;
}

const { text, index } = Astro.props;
---

<p class="tag">
  {index && <span>{index} /</span>}
  {text}
</p>

<style>
  .tag {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    color: var(--color-brand);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
