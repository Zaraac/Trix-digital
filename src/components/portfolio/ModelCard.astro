---
import { Image } from "astro:assets";
import type { PortfolioEntry } from "../../domain/portfolio";
import { categoryLabels, entryTypeLabels } from "../../domain/portfolio";
import Tag from "../ui/Tag.astro";
import { withBase } from "../../utils/url";

interface Props {
  entry: PortfolioEntry;
  index: number;
  featured?: boolean;
}

const { entry, index, featured = false } = Astro.props;
---

<article class:list={["model-card", { "model-card--featured": featured }]}>
  <a class="model-card__link" href={withBase(`/trabalhos/${entry.id}/`)}>
    <div class="model-card__visual">
      <Image
        src={entry.data.cover.image}
        alt={entry.data.cover.alt}
        widths={[480, 768, 1200]}
        sizes={featured ? "(max-width: 896px) 100vw, 800px" : "(max-width: 768px) 100vw, 600px"}
        loading={index === 0 ? "eager" : "lazy"}
      />
      <span>{entryTypeLabels[entry.data.entryType]}</span>
    </div>
    <div class="model-card__content">
      <Tag
        index={String(index + 1).padStart(2, "0")}
        text={categoryLabels[entry.data.category]}
      />
      <h3>{entry.data.title}</h3>
      <p>{entry.data.summary}</p>
      <span class="model-card__cta">
        Conhecer o trabalho
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 19 19 5M8 5h11v11"></path>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .model-card {
    display: grid;
    gap: var(--space-6);
  }

  .model-card__link {
    display: grid;
    gap: var(--space-6);
    color: inherit;
    text-decoration: none;
    transition: transform var(--duration-medium) var(--ease-out);
  }

  .model-card__link:is(:hover, :focus-visible) {
    transform: translateY(-4px);
  }

  .model-card__visual {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    aspect-ratio: 12 / 7;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .model-card__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms var(--ease-standard);
  }

  .model-card__link:is(:hover, :focus-visible) .model-card__visual {
    border-color: var(--color-brand);
  }

  .model-card__link:is(:hover, :focus-visible) .model-card__visual :global(img) {
    transform: scale(1.03);
  }

  .model-card__visual > span {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .model-card__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
  }

  h3 {
    margin-block: var(--space-3) var(--space-3);
    font-size: var(--text-xl);
  }

  p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .model-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    width: max-content;
    margin-top: var(--space-4);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .model-card__cta svg {
    width: 1rem;
    transition: transform var(--duration-small) var(--ease-out);
    color: var(--color-brand);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .model-card__link:is(:hover, :focus-visible) .model-card__cta {
    color: var(--color-brand);
  }

  .model-card__link:is(:hover, :focus-visible) .model-card__cta svg {
    transform: translate(3px, -3px);
  }

  .model-card--featured h3 {
    font-size: var(--text-2xl);
  }

  /* Destaque em duas colunas: imagem e texto lado a lado, cabendo numa tela. */
  @media (min-width: 56rem) {
    .model-card--featured .model-card__link {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-12);
      align-items: center;
    }

    .model-card--featured p {
      font-size: var(--text-base);
    }
  }
</style>
