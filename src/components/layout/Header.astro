---
import ThemeToggle from "../ui/ThemeToggle.astro";
import { withBase } from "../../utils/url";
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={withBase("/")} aria-label="Trix, página inicial">
      <img
        class="header__logo header__logo--dark"
        src={withBase("/assets/logo/trix-logo-on-dark.svg")}
        alt="Trix"
      />
      <img
        class="header__logo header__logo--light"
        src={withBase("/assets/logo/trix-logo-on-light.svg")}
        alt="Trix"
      />
    </a>

    <nav class="header__nav" aria-label="Navegação principal">
      <a href={withBase("/#trabalhos")}>Trabalhos</a>
      <a href={withBase("/#servicos")}>Sites e sistemas</a>
      <a href={withBase("/#sobre")}>Sobre</a>
    </nav>

    <div class="header__actions">
      <ThemeToggle />
      <a class="header__contact" href={withBase("/#contato")}>
        Fale comigo
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 19 19 5M8 5h11v11"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-line);
  }

  .header__inner {
    display: grid;
    min-height: 6.5rem;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .header__brand {
    width: max-content;
  }

  .header__logo {
    width: 6.5rem;
  }

  .header__logo--light {
    display: none;
  }

  :global([data-theme="light"]) .header__logo--dark {
    display: none;
  }

  :global([data-theme="light"]) .header__logo--light {
    display: block;
  }

  .header__nav,
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header__nav a,
  .header__contact {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .header__nav a:hover,
  .header__contact:hover {
    color: var(--color-brand);
  }

  .header__actions {
    justify-self: end;
  }

  .header__contact {
    color: var(--color-text);
  }

  .header__contact svg {
    width: 1rem;
    margin-left: var(--space-3);
    color: var(--color-brand);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  @media (max-width: 48rem) {
    .header__inner {
      min-height: auto;
      grid-template-columns: 1fr auto;
      padding-block: var(--space-4);
    }

    .header__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      gap: var(--space-4);
      padding-top: var(--space-2);
      border-top: 1px solid var(--color-line);
    }

    .header__contact {
      display: none;
    }
  }
</style>
