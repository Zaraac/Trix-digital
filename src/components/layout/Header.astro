---
import ThemeToggle from "../ui/ThemeToggle.astro";
import { withBase } from "../../utils/url";
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={withBase("/")} aria-label="Trix, página inicial">
      <img
        class="header__logo header__logo--dark"
        src={withBase("/assets/logo/trix-logo-on-dark.svg")}
        alt=""
        width="115"
        height="52"
      />
      <img
        class="header__logo header__logo--light"
        src={withBase("/assets/logo/trix-logo-on-light.svg")}
        alt=""
        width="115"
        height="52"
      />
    </a>

    <nav class="header__nav" aria-label="Navegação principal">
      <a href={withBase("/#trabalhos")}>Trabalhos</a>
      <a href={withBase("/#servicos")}>Sites e sistemas</a>
      <a href={withBase("/#sobre")}>Sobre</a>
    </nav>

    <div class="header__actions">
      <ThemeToggle />
      <a class="header__contact" href={withBase("/#contato")}>
        Fale comigo
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 19 19 5M8 5h11v11"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-bg) 95%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: box-shadow var(--duration-medium) var(--ease-standard);
  }

  .header__inner {
    display: grid;
    min-height: var(--header-height);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .header__brand {
    width: max-content;
  }

  .header__logo {
    width: 5.5rem;
    height: auto;
  }

  .header__logo--light {
    display: none;
  }

  :global([data-theme="light"]) .header__logo--dark {
    display: none;
  }

  :global([data-theme="light"]) .header__logo--light {
    display: block;
  }

  .header__nav,
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header__nav a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-size var(--duration-small) var(--ease-standard);
  }

  .header__nav a:is(:hover, :focus-visible) {
    color: var(--color-brand);
    background-size: 100% 1px;
  }

  .header__actions {
    justify-self: end;
    gap: var(--space-4);
  }

  .header__contact {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-4);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .header__contact:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .header__contact svg {
    width: 1rem;
    transition: transform var(--duration-small) var(--ease-out);
    flex: 0 0 auto;
    color: var(--color-brand);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .header__contact:is(:hover, :focus-visible) svg {
    transform: translate(2px, -2px);
  }

  .header[data-scrolled] {
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 25%);
  }

  @media (max-width: 48rem) {
    .header__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-2) var(--space-4);
      padding-block: var(--space-3) 0;
    }

    .header__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: space-between;
      gap: var(--space-4);
      min-height: 2.75rem;
      border-top: 1px solid var(--color-line);
    }

    .header__actions {
      gap: var(--space-2);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".header");
  const onScroll = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
