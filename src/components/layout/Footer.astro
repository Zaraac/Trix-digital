---
import { withBase } from "../../utils/url";
---

<footer class="footer">
  <div class="container footer__inner">
    <a href={withBase("/")} aria-label="Trix, página inicial">
      <img
        class="footer__logo footer__logo--dark"
        src={withBase("/assets/logo/trix-logo-on-dark.svg")}
        alt="Trix"
      />
      <img
        class="footer__logo footer__logo--light"
        src={withBase("/assets/logo/trix-logo-on-light.svg")}
        alt="Trix"
      />
    </a>
    <p>Trix / Portfólio pessoal<br /><span>Sites e sistemas</span></p>
    <a class="footer__top u-underline" href={withBase("/#topo")}>Voltar ao topo ↑</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .footer__logo {
    width: 5.5rem;
  }

  .footer__logo--light {
    display: none;
  }

  :global([data-theme="light"]) .footer__logo--dark {
    display: none;
  }

  :global([data-theme="light"]) .footer__logo--light {
    display: block;
  }

  p,
  .footer__top {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  p span {
    font-family: var(--font-mono);
  }

  .footer__top {
    margin-left: auto;
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 36rem) {
    .footer__inner {
      flex-wrap: wrap;
    }

    .footer__top {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
