# URL pública sem barra final. Necessária para canonical e metadados absolutos.
PUBLIC_SITE_URL=https://seu-dominio.com.br

# Endpoint HTTPS de um serviço de formulário, como Formspree.
PUBLIC_CONTACT_ENDPOINT=

# Canais exibidos na área de contato (com formulário, aparecem como alternativa).
PUBLIC_CONTACT_EMAIL=
# Número com DDD, com ou sem DDI: "11987654321", "+55 (11) 98765-4321".
# Uma URL completa também é aceita, mas é usada sem mensagem pronta.
PUBLIC_CONTACT_WHATSAPP=
